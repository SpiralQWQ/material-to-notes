# Normalize line endings on commit, keep them stable across platforms
* text=auto

# Source & docs: LF everywhere
*.py      text eol=lf
*.md      text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.example text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows-native helpers stay CRLF
*.bat     text eol=crlf
*.ps1     text eol=crlf

# Assets: keep as-is
*.jpg  binary
*.jpeg binary
*.png  binary
*.gif  binary
*.webp binary
