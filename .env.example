# 复制为 .env 并填真实值；用 scripts/set_env.ps1 导出到当前会话。
# .env 不入库（.gitignore 已排除），本模板只留空值，不写任何真实路径。

# ---- 五个零件仓库的位置（可选：留空即用库内 parts/）----
# 2026-10-15 起零件默认取 <仓库>/parts/<零件名>/（见 docs/架构与目录契约.md 第十节）。
# 只有想临时改用外部某一份零件时才填下面几行。
WKC_DIR=
DTMD_DIR=
M2M_DIR=
TCE_DIR=
MRE_DIR=

# ---- 模型密钥（mre 质检评分、m2m 画面理解）----
GLM_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_AUTH_TOKEN=

# ---- 零件自带的引擎：各自 venv 的解释器路径 ----
# m2m：语音转写 / 图片 OCR
ASR_PY=
OCR_PY=
# wkc：网页抓取解释器 / 视频下载器 / 数据根
CRAWL4AI_PY=
DD_YTDLP=
FFMPEG=
KC_BASE=
# tce：正文提取 / 个人信息脱敏
TRAFILATURA_PY=
PRESIDIO_PY=
# dtmd：公式 OCR 环境（本部署文档线走云端，不需要本地 MinerU）
DTM_PIX2TEXT_ENV=
